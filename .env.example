# Copy to .env for local docker compose, or enter these in Coolify > Environment Variables.
# Use letters and digits only in POSTGRES_PASSWORD (it is embedded in a URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@saphardware.in
ADMIN_PASSWORD=change-me-too
# Optional. If empty, a key is generated and stored in the database.
SECRET_KEY=
